page {
  min-height: 100%;
  background: #f6f8f7;
  color: #1f2a24;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

view,
text,
button,
input {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border-radius: 8rpx;
  line-height: 1;
  background: transparent;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding: 28rpx;
  background: #f6f8f7;
}

.card {
  background: #ffffff;
  border: 1rpx solid #e6ece8;
  border-radius: 24rpx;
  box-shadow: 0 14rpx 34rpx rgba(31, 42, 36, 0.08);
  transition: transform 0.16s ease, box-shadow 0.16s ease;
}

.card-press {
  transform: scale(0.985);
  box-shadow: 0 8rpx 18rpx rgba(31, 42, 36, 0.08);
}

.primary-btn {
  height: 92rpx;
  border-radius: 22rpx;
  background: #16835b;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 20rpx rgba(22, 131, 91, 0.16);
}

.ghost-btn {
  height: 86rpx;
  border: 2rpx solid #dbe3de;
  border-radius: 22rpx;
  color: #526159;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
}

.muted {
  color: #7d8982;
}
