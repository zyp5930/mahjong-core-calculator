page {
  min-height: 100%;
  background: #f8f5ec;
  color: #1f2a24;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

view,
text,
button,
input {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border-radius: 8rpx;
  line-height: 1;
  background: transparent;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding: 28rpx;
  background:
    linear-gradient(180deg, #fff5df 0%, #f8f5ec 42%, #f6f8f7 100%);
}

.card {
  background: #fffdf8;
  border: 1rpx solid #eee4d4;
  border-radius: 24rpx;
  box-shadow: 0 18rpx 40rpx rgba(96, 69, 34, 0.1);
  transition: transform 0.16s ease, box-shadow 0.16s ease;
}

.card-press {
  transform: scale(0.985);
  box-shadow: 0 10rpx 22rpx rgba(96, 69, 34, 0.1);
}

.primary-btn {
  height: 92rpx;
  border-radius: 22rpx;
  background: #12855a;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 20rpx rgba(18, 133, 90, 0.2);
}

.ghost-btn {
  height: 86rpx;
  border: 2rpx solid #ded7ca;
  border-radius: 22rpx;
  color: #526159;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fffdf8;
}

.muted {
  color: #7d8982;
}
