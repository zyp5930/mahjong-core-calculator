<view class="room-page">
  <view class="toolbar">
    <button class="tool invite-tool" bindtap="openInvite">
      <text class="tool-icon">邀</text>
      <text>邀请</text>
    </button>
    <button class="tool detail-tool" bindtap="openDetail">
      <text class="tool-icon">明</text>
      <text>明细</text>
    </button>
    <button class="tool end-tool" bindtap="openSettlementDialog" wx:if="{{table && table.status === 'active' && myPlayer && table.ownerOpenid === myPlayer.openid}}">
      <text class="tool-icon">终</text>
      <text>结束</text>
    </button>
  </view>

  <view class="join-tip" wx:if="{{table && !myPlayer}}">
    <text>加入牌局后开始计分</text>
    <button bindtap="openJoin">加入</button>
  </view>

  <view class="players">
    <view class="player-card card" wx:for="{{players}}" wx:key="id">
      <view class="avatar-wrap">
        <image
          wx:if="{{item.avatarDisplayUrl && !item.avatarLoadFailed}}"
          class="avatar image-avatar"
          src="{{item.avatarDisplayUrl}}"
          mode="aspectFill"
          bindload="onAvatarLoad"
          binderror="onAvatarError"
          data-id="{{item.id}}"
          data-view-key="{{item.viewKey}}"
          data-avatar-file-id="{{item.avatarFileId}}"
          data-avatar-url="{{item.avatarDisplayUrl}}"
        ></image>
        <view wx:else class="avatar" style="background: {{item.avatarColor}}">{{item.initial}}</view>
        <view wx:if="{{item.rankEmoji}}" class="rank-emoji">{{item.rankEmoji}}</view>
        <view wx:if="{{item.isOwner}}" class="owner-badge">桌主</view>
      </view>
      <view class="player-main">
        <view class="player-name">{{item.name}}</view>
        <view class="score-line {{item.score >= 0 ? 'win' : 'lose'}}">
          <text>{{item.score >= 0 ? '赢：' : '输：'}}</text>
          <text class="score-num">{{item.absScore}}</text>
        </view>
      </view>
      <view wx:if="{{canGive && item.id !== myPlayer.id}}" class="action-group">
        <button class="give-btn" bindtap="openKeypad" data-id="{{item.id}}">给分</button>
        <button class="undo-btn" bindtap="undoLastGive" data-id="{{item.id}}">撤销</button>
      </view>
      <view wx:else class="give-placeholder"></view>
    </view>
  </view>

  <view class="ended-mask" wx:if="{{table.status === 'ended'}}">牌局已结束，仅可查看</view>

  <view class="next-round-panel" wx:if="{{canStartNextRound}}">
    <view class="next-round-text">
      <text class="next-round-title">{{table.nextTableId ? '下一局已开启' : '继续本组对局'}}</text>
      <text class="next-round-subtitle">同组玩家会自动带入下一局</text>
    </view>
    <view class="next-round-actions">
      <button wx:if="{{canSettleGroup}}" class="settle-group-btn" bindtap="openSettlementInput" data-mode="group">结算所有</button>
      <button bindtap="startNextRound">{{table.nextTableId ? '进入下一局' : '开启下一局'}}</button>
    </view>
  </view>

  <view class="notice-stack" wx:if="{{noticeToasts.length}}">
    <view class="notice-toast" wx:for="{{noticeToasts}}" wx:key="id">
      <text class="notice-text">{{item.text}}</text>
      <text class="notice-close" bindtap="closeNotice" data-id="{{item.id}}">×</text>
    </view>
  </view>

  <view class="sheet-mask" wx:if="{{inviteVisible}}" bindtap="closeInvite"></view>
  <view class="invite-sheet" wx:if="{{inviteVisible}}">
    <view class="invite-title">扫码加入牌局</view>
    <view class="invite-subtitle">微信扫码后可直接进入 {{table.name}}</view>
    <view class="invite-code-wrap">
      <view wx:if="{{inviteLoading}}" class="invite-placeholder">正在生成二维码...</view>
      <image wx:elif="{{inviteCodeImage}}" class="invite-code" src="{{inviteCodeImage}}" mode="aspectFit"></image>
      <view wx:else class="invite-placeholder">暂时无法生成二维码</view>
    </view>
    <view class="invite-share-code">分享码：{{table.shareCode}}</view>
    <button class="primary-btn invite-close" bindtap="closeInvite">完成</button>
  </view>

  <view class="sheet-mask" wx:if="{{keypadVisible}}" bindtap="closeKeypad"></view>
  <view class="score-sheet" wx:if="{{keypadVisible}}">
    <view class="sheet-player">
      <image
        wx:if="{{targetPlayer.avatarDisplayUrl && !targetPlayer.avatarLoadFailed}}"
        class="sheet-avatar image-avatar"
        src="{{targetPlayer.avatarDisplayUrl}}"
        mode="aspectFill"
        bindload="onAvatarLoad"
        binderror="onAvatarError"
        data-id="{{targetPlayer.id}}"
        data-view-key="{{targetPlayer.viewKey}}"
        data-avatar-file-id="{{targetPlayer.avatarFileId}}"
        data-avatar-url="{{targetPlayer.avatarDisplayUrl}}"
      ></image>
      <view wx:else class="sheet-avatar" style="background: {{targetPlayer.avatarColor}}">{{targetPlayer.initial}}</view>
      <text>{{targetPlayer.name}}</text>
    </view>
    <view class="score-input-row">
      <view class="score-input {{inputValue ? '' : 'placeholder'}}">{{inputValue || '请输入分数'}}</view>
      <view class="score-delete" catchtap="clearInput">
        <text class="delete-icon">⌫</text>
      </view>
    </view>
    <view class="keypad">
      <button wx:for="{{keys}}" wx:key="*this" data-key="{{item}}" bindtap="tapKey" class="{{item === '确认' ? 'confirm' : ''}}">{{item}}</button>
    </view>
  </view>

  <view class="sheet-mask" wx:if="{{settlementVisible}}" bindtap="closeSettlement"></view>
  <view class="settlement-sheet" wx:if="{{settlementVisible}}">
    <view class="settlement-title">{{settlementTitle}}</view>
    <view class="settlement-subtitle">{{settlementSubtitle}}</view>
    <view class="settlement-input-row">
      <input type="digit" value="{{endInputValue}}" bindinput="onEndInput" placeholder="例如 0.3" />
    </view>
    <view class="settlement-actions">
      <button bindtap="closeSettlement">取消</button>
      <button class="confirm" bindtap="confirmEndTable">{{settlementConfirmText}}</button>
    </view>
  </view>

  <view class="settlement-panel" wx:if="{{table && table.status === 'ended' && finalScores.length}}">
    <view class="settlement-panel-title">结算结果</view>
    <view class="settlement-panel-meta">倍率：{{settlementMultiplier}}x</view>
    <view class="settlement-row" wx:for="{{finalScores}}" wx:key="playerId">
      <text>{{item.name}}</text>
      <text>{{item.rawScore}} × {{settlementMultiplier}} = {{item.finalScore}}</text>
    </view>
  </view>

  <view class="settlement-panel group-settlement-panel" wx:if="{{groupSettlement && groupSettlement.finalScores.length}}">
    <view class="settlement-panel-title">所有对局结算</view>
    <view class="settlement-panel-meta">共 {{groupSettlement.tableCount}} 局</view>
    <view class="group-settlement-row" wx:for="{{groupSettlement.finalScores}}" wx:key="groupPlayerId">
      <view class="group-score-main">
        <text class="group-score-name">{{item.name}}</text>
        <text class="{{item.totalScore >= 0 ? 'group-score-win' : 'group-score-lose'}}">{{item.totalScore}}</text>
      </view>
      <view class="round-score-list">
        <text wx:for="{{item.roundScores}}" wx:for-item="round" wx:key="tableId">第{{round.roundNo}}局 {{round.score}}</text>
      </view>
    </view>
  </view>

  <view class="bottom-actions">
    <button class="refresh-btn" bindtap="refreshTable">刷新当前页面</button>
  </view>
</view>
