.room-page {
  min-height: 100vh;
  padding-bottom: 36rpx;
  background:
    linear-gradient(180deg, #fff7e7 0%, #f7f6f1 34%, #f6f8f7 100%);
}

.toolbar {
  min-height: 136rpx;
  padding: 20rpx 42rpx 16rpx;
  background: rgba(255, 253, 248, 0.96);
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #f0e6d6;
  box-shadow: 0 8rpx 22rpx rgba(96, 69, 34, 0.06);
}

.table-strip {
  margin: 20rpx 24rpx 0;
  padding: 22rpx 24rpx;
  border: 1rpx solid #d8ebe2;
  border-radius: 24rpx;
  background: #fffdf8;
  box-shadow: 0 14rpx 34rpx rgba(96, 69, 34, 0.08);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.table-strip-main {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 18rpx;
  flex: 1;
}

.round-badge {
  min-width: 86rpx;
  height: 44rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #e3f2ea;
  color: #12855a;
  font-size: 24rpx;
  line-height: 44rpx;
  text-align: center;
  font-weight: 700;
  flex: 0 0 auto;
}

.table-title-wrap {
  min-width: 0;
  flex: 1;
}

.table-title {
  color: #1f2a24;
  font-size: 34rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.table-subtitle {
  margin-top: 6rpx;
  color: #7d8982;
  font-size: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.table-state {
  flex: 0 0 auto;
  height: 46rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 46rpx;
  font-weight: 700;
}

.table-state.active {
  background: #e3f2ea;
  color: #12855a;
}

.table-state.ended {
  background: #eef1ef;
  color: #7b8680;
}

.tool {
  width: 120rpx;
  min-height: 100rpx;
  margin: 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
  color: #526159;
  font-size: 26rpx;
  line-height: 1.2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  min-width: 0;
}

.tool::after {
  border: 0;
}

.tool-icon {
  width: 56rpx;
  height: 56rpx;
  border: 1rpx solid #eadcc4;
  border-radius: 12rpx;
  background: #fffef8;
  color: #6b7870;
  font-size: 34rpx;
  line-height: 56rpx;
  text-align: center;
  font-weight: 700;
  box-shadow: none;
}

.tool text:last-child {
  width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
  font-weight: 600;
}

.invite-tool {
  color: #12855a;
}

.invite-tool .tool-icon {
  color: #12855a;
}

.detail-tool {
  color: #315f8e;
}

.detail-tool .tool-icon {
  color: #315f8e;
}

.end-tool {
  color: #c94d3f;
}

.end-tool .tool-icon {
  color: #c84636;
}

.join-tip {
  margin: 24rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid #d8ebe2;
  border-radius: 22rpx;
  background: #fffdf8;
  color: #3d6f5a;
  font-size: 28rpx;
  box-shadow: 0 14rpx 34rpx rgba(96, 69, 34, 0.09);
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
}

.join-tip text {
  flex: 1;
  min-width: 0;
}

.join-tip button {
  width: 160rpx;
  height: 64rpx;
  margin: 0;
  padding: 0;
  flex: 0 0 auto;
  border-radius: 16rpx;
  background: #12855a;
  color: #ffffff;
  font-size: 26rpx;
  line-height: 64rpx;
}

.join-tip button::after {
  border: 0;
}

.players {
  padding: 24rpx;
}

.player-card {
  min-height: 144rpx;
  margin-bottom: 22rpx;
  padding: 26rpx 24rpx;
  display: flex;
  align-items: center;
  border-radius: 24rpx;
  position: relative;
  overflow: hidden;
  background: #fffdf8;
  border-color: #eee4d4;
  box-shadow: 0 18rpx 40rpx rgba(96, 69, 34, 0.09);
}

.player-card::before {
  content: "";
  position: absolute;
  left: 0;
  top: 28rpx;
  bottom: 28rpx;
  width: 6rpx;
  border-radius: 0 999rpx 999rpx 0;
  background: #d8ebe2;
}

.avatar-wrap {
  width: 110rpx;
  height: 92rpx;
  position: relative;
  flex: 0 0 auto;
}

.avatar {
  width: 90rpx;
  height: 90rpx;
  border-radius: 22rpx;
  color: #ffffff;
  font-size: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: none;
}

.image-avatar {
  object-fit: cover;
}

.owner-badge {
  position: absolute;
  left: 62rpx;
  bottom: -8rpx;
  min-width: 64rpx;
  height: 42rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: #12855a;
  color: #ffffff;
  font-size: 22rpx;
  line-height: 42rpx;
  text-align: center;
}

.rank-emoji {
  position: absolute;
  right: 2rpx;
  top: -20rpx;
  width: 54rpx;
  height: 54rpx;
  font-size: 42rpx;
  line-height: 54rpx;
  text-align: center;
  text-shadow: 0 2rpx 6rpx rgba(47, 51, 55, 0.2);
}

.player-main {
  flex: 1;
  min-width: 0;
  padding-left: 22rpx;
}

.player-name {
  max-width: 330rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #1f2a24;
  font-size: 36rpx;
  font-weight: 700;
}

.score-line {
  margin-top: 14rpx;
  font-size: 30rpx;
  color: #68746d;
  display: inline-flex;
  align-items: baseline;
}

.score-line.win {
  color: #c84636;
}

.score-line.lose {
  color: #526159;
}

.score-line.even {
  color: #8a958f;
}

.score-num {
  margin-left: 10rpx;
  min-width: 72rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #f4f7f5;
  font-size: 42rpx;
  font-weight: 700;
  text-align: center;
}

.score-line.win .score-num {
  background: #fff0ed;
}

.score-line.lose .score-num {
  background: #edf1ef;
}

.score-line.even .score-num {
  background: #f5f6f5;
}

.action-group {
  width: 230rpx;
  flex: 0 0 auto;
  display: flex;
  gap: 12rpx;
}

.give-btn,
.undo-btn {
  flex: 1;
  height: 84rpx;
  border-radius: 22rpx;
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.give-btn {
  background: #12855a;
  color: #ffffff;
  box-shadow: 0 10rpx 22rpx rgba(18, 133, 90, 0.2);
}

.undo-btn {
  border: 1rpx solid #ded7ca;
  background: #fffdf8;
  color: #526159;
  font-size: 30rpx;
}

.give-placeholder {
  width: 230rpx;
}

.ended-mask {
  margin: 0 24rpx;
  padding: 24rpx;
  border: 1rpx solid #eee4d4;
  border-radius: 24rpx;
  background: #fffdf8;
  color: #7d8982;
  text-align: center;
  font-size: 28rpx;
  box-shadow: 0 14rpx 34rpx rgba(96, 69, 34, 0.09);
}

.next-round-panel {
  margin: 22rpx 24rpx 0;
  padding: 24rpx;
  border: 1rpx solid #d8ebe2;
  border-radius: 24rpx;
  background: #fffdf8;
  box-shadow: 0 14rpx 34rpx rgba(96, 69, 34, 0.09);
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 18rpx;
}

.next-round-text {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.next-round-title {
  color: #1f2a24;
  font-size: 30rpx;
  font-weight: 700;
}

.next-round-subtitle {
  color: #7d8982;
  font-size: 24rpx;
}

.next-round-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.next-round-panel button {
  height: 72rpx;
  margin: 0;
  padding: 0;
  border-radius: 18rpx;
  background: #12855a;
  color: #ffffff;
  font-size: 26rpx;
  line-height: 72rpx;
  flex: 0 0 auto;
}

.next-round-panel .next-round-primary {
  flex: 1;
  min-width: 0;
}

.next-round-panel .settle-group-btn {
  width: 168rpx;
  border: 1rpx solid #ded7ca;
  background: #fffdf8;
  color: #526159;
}

.next-round-extra {
  display: flex;
  justify-content: flex-end;
  margin-top: -6rpx;
}

.next-round-panel .settle-table-btn {
  width: auto;
  height: 42rpx;
  padding: 0 4rpx;
  border-radius: 0;
  background: transparent;
  color: #8a958f;
  font-size: 24rpx;
  line-height: 42rpx;
}

.next-round-panel button::after {
  border: 0;
}

.notice-stack {
  position: fixed;
  left: 32rpx;
  top: 184rpx;
  z-index: 12;
  max-width: calc(100vw - 64rpx);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 12rpx;
  pointer-events: none;
}

.notice-toast {
  max-width: 100%;
  min-height: 60rpx;
  padding: 12rpx 18rpx 12rpx 24rpx;
  border-radius: 16rpx;
  border: 1rpx solid #d8ebe2;
  border-left: 8rpx solid #12855a;
  background: #f4fbf7;
  box-shadow: 0 10rpx 24rpx rgba(18, 133, 90, 0.1);
  display: inline-flex;
  align-items: flex-start;
  gap: 14rpx;
  box-sizing: border-box;
  pointer-events: auto;
}

.notice-toast .notice-text {
  flex: 0 1 auto;
  min-width: 0;
  max-width: calc(100vw - 150rpx);
  color: #315447;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.35;
  word-break: break-all;
}

.notice-close {
  min-width: 32rpx;
  height: 40rpx;
  margin: -2rpx 0 0;
  color: #6e7c75;
  font-size: 40rpx;
  line-height: 40rpx;
  text-align: center;
  flex: 0 0 auto;
  opacity: 0.92;
}

.invite-sheet {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  z-index: 11;
  padding: 36rpx 32rpx;
  border-radius: 28rpx;
  background: #fffdf8;
  box-shadow: 0 24rpx 56rpx rgba(96, 69, 34, 0.18);
}

.invite-title {
  color: #1f2a24;
  font-size: 36rpx;
  text-align: center;
}

.invite-subtitle {
  margin-top: 16rpx;
  color: #7d8982;
  font-size: 26rpx;
  text-align: center;
}

.invite-code-wrap {
  margin: 28rpx auto 0;
  width: 440rpx;
  height: 440rpx;
  border-radius: 24rpx;
  background: #f8f5ec;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.invite-code {
  width: 100%;
  height: 100%;
}

.invite-placeholder {
  color: #7d8982;
  font-size: 28rpx;
}

.invite-share-code {
  margin-top: 20rpx;
  color: #526159;
  font-size: 26rpx;
  text-align: center;
}

.invite-close {
  margin-top: 28rpx;
}

.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 10;
  background: rgba(0, 0, 0, 0.35);
}

.score-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 11;
  width: 100vw;
  padding: 38rpx 30rpx calc(34rpx + env(safe-area-inset-bottom));
  border-radius: 30rpx 30rpx 0 0;
  background: #f8f5ec;
  overflow: hidden;
}

.settlement-sheet {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  z-index: 11;
  padding: 34rpx 30rpx;
  border-radius: 28rpx;
  background: #fffdf8;
  box-shadow: 0 24rpx 56rpx rgba(96, 69, 34, 0.18);
}

.settlement-title {
  color: #1f2a24;
  font-size: 36rpx;
  text-align: center;
}

.settlement-subtitle {
  margin-top: 14rpx;
  color: #7d8982;
  font-size: 26rpx;
  text-align: center;
}

.settlement-input-row {
  margin-top: 26rpx;
  border: 1rpx solid #ded7ca;
  border-radius: 22rpx;
  overflow: hidden;
}

.settlement-input-row input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  font-size: 34rpx;
  box-sizing: border-box;
}

.settlement-actions {
  margin-top: 26rpx;
  display: flex;
  gap: 16rpx;
}

.settlement-actions button {
  flex: 1;
  height: 82rpx;
  border-radius: 22rpx;
  font-size: 30rpx;
  line-height: 82rpx;
}

.settlement-actions .confirm {
  background: #12855a;
  color: #ffffff;
}

.settlement-panel {
  margin: 24rpx;
  padding: 24rpx 26rpx;
  border: 1rpx solid #eee4d4;
  border-radius: 24rpx;
  background: #fffdf8;
  box-shadow: 0 18rpx 40rpx rgba(96, 69, 34, 0.09);
}

.settlement-panel-title {
  color: #1f2a24;
  font-size: 32rpx;
}

.settlement-panel-meta {
  margin-top: 8rpx;
  color: #7d8982;
  font-size: 24rpx;
}

.settlement-row {
  margin-top: 18rpx;
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  color: #526159;
  font-size: 26rpx;
}

.group-settlement-panel {
  border-color: #d8ebe2;
}

.group-settlement-row {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f0e6d6;
}

.group-score-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.group-score-name {
  flex: 1;
  min-width: 0;
  color: #1f2a24;
  font-size: 28rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.group-score-win,
.group-score-lose {
  min-width: 120rpx;
  text-align: right;
  font-size: 34rpx;
  font-weight: 700;
}

.group-score-win {
  color: #c84636;
}

.group-score-lose {
  color: #526159;
}

.round-score-list {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.round-score-list text {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #f4f7f5;
  color: #68746d;
  font-size: 22rpx;
}

.bottom-actions {
  padding: 40rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
}

.refresh-btn {
  width: 100%;
  height: 88rpx;
  border: 1rpx solid #ded7ca;
  border-radius: 22rpx;
  background: #fffdf8;
  color: #526159;
  font-size: 30rpx;
  line-height: 88rpx;
}

.sheet-player {
  display: flex;
  align-items: center;
  gap: 20rpx;
  color: #1f2a24;
  font-size: 36rpx;
}

.sheet-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  color: #ffffff;
  font-size: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.score-input-row {
  position: relative;
  height: 98rpx;
  margin-top: 30rpx;
  border: 1rpx solid #ded7ca;
  border-radius: 22rpx;
  background: #fffdf8;
  overflow: hidden;
}

.score-input {
  padding: 0 106rpx 0 30rpx;
  color: #1f2a24;
  font-size: 38rpx;
  line-height: 98rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.score-input.placeholder {
  color: #9aa5a0;
}

.score-delete {
  position: absolute;
  right: 0;
  top: 0;
  width: 98rpx;
  height: 98rpx;
  margin: 0;
  padding: 0;
  border-left: 1rpx solid #eee4d4;
  border-radius: 0;
  background: #fffdf8;
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-icon {
  color: #68746d;
  font-size: 38rpx;
  line-height: 1;
}

.keypad {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20rpx 18rpx;
  width: 100%;
}

.keypad button {
  width: 100%;
  min-width: 0;
  height: 104rpx;
  border: 1rpx solid #ded7ca;
  border-radius: 22rpx;
  background: #fffdf8;
  color: #1f2a24;
  font-size: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.keypad button.confirm {
  background: #12855a;
  border-color: #12855a;
  color: #ffffff;
  font-size: 34rpx;
}

.keypad button.disabled {
  opacity: 0.52;
}
