.room-page {
  min-height: 100vh;
  padding-bottom: 36rpx;
  background: #eef1f3;
}

.toolbar {
  min-height: 136rpx;
  padding: 20rpx 42rpx 16rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #e7eaed;
}

.tool {
  width: 120rpx;
  min-height: 100rpx;
  margin: 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
  color: #59616a;
  font-size: 26rpx;
  line-height: 1.2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  min-width: 0;
}

.tool::after {
  border: 0;
}

.tool-icon {
  width: 56rpx;
  height: 56rpx;
  color: #858b92;
  font-size: 34rpx;
  line-height: 56rpx;
  text-align: center;
  font-weight: 700;
}

.tool text:last-child {
  width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
  font-weight: 600;
}

.invite-tool {
  color: #2f8f5b;
}

.invite-tool .tool-icon {
  color: #39b879;
}

.detail-tool {
  color: #456f9d;
}

.detail-tool .tool-icon {
  color: #6b9fe8;
}

.end-tool {
  color: #c94d3f;
}

.end-tool .tool-icon {
  color: #f15d4f;
}

.join-tip {
  margin: 24rpx;
  padding: 22rpx 24rpx;
  border-radius: 8rpx;
  background: #fff7e6;
  color: #8a5a00;
  font-size: 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
}

.join-tip text {
  flex: 1;
  min-width: 0;
}

.join-tip button {
  width: 160rpx;
  height: 64rpx;
  margin: 0;
  padding: 0;
  flex: 0 0 auto;
  background: #39b879;
  color: #ffffff;
  font-size: 26rpx;
  line-height: 64rpx;
}

.join-tip button::after {
  border: 0;
}

.players {
  padding: 24rpx;
}

.player-card {
  min-height: 144rpx;
  margin-bottom: 22rpx;
  padding: 24rpx 22rpx;
  display: flex;
  align-items: center;
}

.avatar-wrap {
  width: 110rpx;
  height: 92rpx;
  position: relative;
  flex: 0 0 auto;
}

.avatar {
  width: 90rpx;
  height: 90rpx;
  border-radius: 12rpx;
  color: #ffffff;
  font-size: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.image-avatar {
  object-fit: cover;
}

.owner-badge {
  position: absolute;
  left: 62rpx;
  top: -16rpx;
  min-width: 64rpx;
  height: 42rpx;
  padding: 0 10rpx;
  border-radius: 20rpx 20rpx 20rpx 0;
  background: #f15d4f;
  color: #ffffff;
  font-size: 22rpx;
  line-height: 42rpx;
  text-align: center;
}

.player-main {
  flex: 1;
  min-width: 0;
  padding-left: 22rpx;
}

.player-name {
  max-width: 330rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #303438;
  font-size: 36rpx;
}

.score-line {
  margin-top: 18rpx;
  font-size: 30rpx;
  color: #60666d;
}

.score-line.win {
  color: #e95d4d;
}

.score-line.lose {
  color: #60666d;
}

.score-num {
  margin-left: 10rpx;
  font-size: 42rpx;
  font-weight: 700;
}

.action-group {
  width: 248rpx;
  flex: 0 0 auto;
  display: flex;
  gap: 12rpx;
}

.give-btn,
.undo-btn {
  flex: 1;
  height: 84rpx;
  border-radius: 8rpx;
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.give-btn {
  background: #39b879;
  color: #ffffff;
}

.undo-btn {
  border: 1rpx solid #d7dadd;
  background: #ffffff;
  color: #60666d;
  font-size: 30rpx;
}

.give-placeholder {
  width: 248rpx;
}

.ended-mask {
  margin: 0 24rpx;
  padding: 24rpx;
  border-radius: 8rpx;
  background: #ffffff;
  color: #8d949c;
  text-align: center;
  font-size: 28rpx;
}

.notice-stack {
  position: fixed;
  left: 32rpx;
  top: 184rpx;
  z-index: 12;
  max-width: calc(100vw - 64rpx);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 12rpx;
  pointer-events: none;
}

.notice-toast {
  max-width: 100%;
  min-height: 60rpx;
  padding: 12rpx 18rpx 12rpx 24rpx;
  border-radius: 12rpx;
  background: rgba(48, 52, 56, 0.88);
  box-shadow: 0 10rpx 28rpx rgba(20, 24, 28, 0.18);
  display: inline-flex;
  align-items: flex-start;
  gap: 14rpx;
  box-sizing: border-box;
  pointer-events: auto;
}

.notice-toast .notice-text {
  flex: 0 1 auto;
  min-width: 0;
  max-width: calc(100vw - 150rpx);
  color: #ffffff;
  font-size: 30rpx;
  line-height: 1.35;
  word-break: break-all;
}

.notice-close {
  min-width: 32rpx;
  height: 40rpx;
  margin: -2rpx 0 0;
  color: #ffffff;
  font-size: 40rpx;
  line-height: 40rpx;
  text-align: center;
  flex: 0 0 auto;
  opacity: 0.92;
}

.invite-sheet {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  z-index: 11;
  padding: 36rpx 32rpx;
  border-radius: 16rpx;
  background: #ffffff;
}

.invite-title {
  color: #303438;
  font-size: 36rpx;
  text-align: center;
}

.invite-subtitle {
  margin-top: 16rpx;
  color: #7b838b;
  font-size: 26rpx;
  text-align: center;
}

.invite-code-wrap {
  margin: 28rpx auto 0;
  width: 440rpx;
  height: 440rpx;
  border-radius: 12rpx;
  background: #f4f6f8;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.invite-code {
  width: 100%;
  height: 100%;
}

.invite-placeholder {
  color: #8d949c;
  font-size: 28rpx;
}

.invite-share-code {
  margin-top: 20rpx;
  color: #8a5a00;
  font-size: 26rpx;
  text-align: center;
}

.invite-close {
  margin-top: 28rpx;
}

.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 10;
  background: rgba(0, 0, 0, 0.35);
}

.score-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 11;
  width: 100vw;
  padding: 38rpx 30rpx calc(34rpx + env(safe-area-inset-bottom));
  border-radius: 18rpx 18rpx 0 0;
  background: #eef1f3;
  overflow: hidden;
}

.settlement-sheet {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  z-index: 11;
  padding: 34rpx 30rpx;
  border-radius: 16rpx;
  background: #ffffff;
}

.settlement-title {
  color: #303438;
  font-size: 36rpx;
  text-align: center;
}

.settlement-subtitle {
  margin-top: 14rpx;
  color: #7b838b;
  font-size: 26rpx;
  text-align: center;
}

.settlement-input-row {
  margin-top: 26rpx;
  border: 1rpx solid #d7dadd;
  border-radius: 8rpx;
  overflow: hidden;
}

.settlement-input-row input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  font-size: 34rpx;
  box-sizing: border-box;
}

.settlement-actions {
  margin-top: 26rpx;
  display: flex;
  gap: 16rpx;
}

.settlement-actions button {
  flex: 1;
  height: 82rpx;
  border-radius: 8rpx;
  font-size: 30rpx;
  line-height: 82rpx;
}

.settlement-actions .confirm {
  background: #39b879;
  color: #ffffff;
}

.settlement-panel {
  margin: 24rpx;
  padding: 24rpx 26rpx;
  border-radius: 8rpx;
  background: #ffffff;
}

.settlement-panel-title {
  color: #303438;
  font-size: 32rpx;
}

.settlement-panel-meta {
  margin-top: 8rpx;
  color: #8d949c;
  font-size: 24rpx;
}

.settlement-row {
  margin-top: 18rpx;
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  color: #60666d;
  font-size: 26rpx;
}

.bottom-actions {
  padding: 40rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
}

.refresh-btn {
  width: 100%;
  height: 88rpx;
  border: 1rpx solid #d7dadd;
  border-radius: 8rpx;
  background: #ffffff;
  color: #60666d;
  font-size: 30rpx;
  line-height: 88rpx;
}

.sheet-player {
  display: flex;
  align-items: center;
  gap: 20rpx;
  color: #303438;
  font-size: 36rpx;
}

.sheet-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  color: #ffffff;
  font-size: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.score-input-row {
  position: relative;
  height: 98rpx;
  margin-top: 30rpx;
  border: 1rpx solid #d7dadd;
  border-radius: 8rpx;
  background: #ffffff;
  overflow: hidden;
}

.score-input {
  padding: 0 106rpx 0 30rpx;
  color: #303438;
  font-size: 38rpx;
  line-height: 98rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.score-input.placeholder {
  color: #a2a8af;
}

.score-delete {
  position: absolute;
  right: 0;
  top: 0;
  width: 98rpx;
  height: 98rpx;
  margin: 0;
  padding: 0;
  border-left: 1rpx solid #d7dadd;
  border-radius: 0;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-icon {
  color: #707780;
  font-size: 38rpx;
  line-height: 1;
}

.keypad {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20rpx 18rpx;
  width: 100%;
}

.keypad button {
  width: 100%;
  min-width: 0;
  height: 104rpx;
  border: 1rpx solid #d7dadd;
  border-radius: 8rpx;
  background: #ffffff;
  color: #303438;
  font-size: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.keypad button.confirm {
  background: #39b879;
  border-color: #39b879;
  color: #ffffff;
  font-size: 34rpx;
}
