<view class="page join-page">
  <view class="card intro">
    <view class="title">{{table.name}}</view>
    <view class="muted">{{myPlayer ? '修改你的昵称和头像。' : '输入你的牌桌昵称，加入后就可以给其他玩家计分。'}}</view>
  </view>

  <view class="player-list" wx:if="{{players.length > 1}}">
    <view class="player-card card {{item.openid ? 'disabled' : ''}}" wx:for="{{players}}" wx:key="id" bindtap="selectPlayer" data-id="{{item.id}}" hover-class="card-press" hover-stay-time="80">
      <view class="avatar" style="background: {{item.avatarColor}}">{{item.initial}}</view>
      <view class="player-info">
        <view class="name">{{item.name}}</view>
        <view class="muted">{{item.openid ? '已绑定' : '可选择'}}</view>
      </view>
      <view class="radio {{selectedId === item.id ? 'checked' : ''}}"></view>
    </view>
  </view>

  <view class="card avatar-card">
    <text>微信头像</text>
    <view class="avatar-picker">
      <image wx:if="{{avatarUrl}}" class="avatar-preview" src="{{avatarUrl}}" mode="aspectFill"></image>
      <view wx:else class="avatar-fallback">{{name.slice(0, 1) || '微'}}</view>
      <view class="avatar-copy">{{avatarUrl ? '重新选择头像' : '选择微信头像'}}</view>
    </view>
    <button class="avatar-hit-area" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" hover-class="none"></button>
  </view>

  <view class="card name-card">
    <text>我的昵称</text>
    <input
      type="nickname"
      value="{{name}}"
      focus="{{nameInputFocus}}"
      cursor="{{name.length}}"
      bindinput="onNameInput"
      bindblur="onNameBlur"
      placeholder="输入你的牌桌昵称"
    />
  </view>

  <button class="primary-btn bind-btn" bindtap="bindPlayer">{{myPlayer ? '保存资料' : '加入牌局'}}</button>
</view>
