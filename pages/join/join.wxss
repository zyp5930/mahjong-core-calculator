.intro {
  padding: 30rpx;
}

.title {
  margin-bottom: 14rpx;
  font-size: 36rpx;
  color: #303438;
}

.player-list {
  margin-top: 24rpx;
}

.player-card {
  min-height: 118rpx;
  margin-bottom: 18rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
}

.player-card.disabled {
  opacity: 0.55;
}

.avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 12rpx;
  color: #ffffff;
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.player-info {
  flex: 1;
  min-width: 0;
  padding-left: 22rpx;
}

.name {
  font-size: 32rpx;
  color: #303438;
}

.radio {
  width: 38rpx;
  height: 38rpx;
  border: 2rpx solid #c8cdd2;
  border-radius: 50%;
}

.radio.checked {
  border: 12rpx solid #39b879;
}

.name-card {
  margin-top: 24rpx;
  padding: 24rpx;
}

.name-card text {
  display: block;
  margin-bottom: 14rpx;
  color: #626970;
  font-size: 28rpx;
}

input {
  height: 84rpx;
  padding: 0 22rpx;
  border: 1rpx solid #dfe3e6;
  border-radius: 8rpx;
  font-size: 30rpx;
}

.bind-btn {
  margin-top: 32rpx;
}
