.intro {
  padding: 34rpx;
}

.title {
  margin-bottom: 14rpx;
  font-size: 36rpx;
  color: #1f2a24;
  font-weight: 800;
}

.player-list {
  margin-top: 24rpx;
}

.player-card {
  min-height: 118rpx;
  margin-bottom: 18rpx;
  padding: 22rpx 24rpx;
  display: flex;
  align-items: center;
}

.player-card.disabled {
  opacity: 0.58;
}

.avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  color: #ffffff;
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.player-info {
  flex: 1;
  min-width: 0;
  padding-left: 22rpx;
}

.name {
  font-size: 32rpx;
  color: #1f2a24;
  font-weight: 700;
}

.radio {
  width: 38rpx;
  height: 38rpx;
  border: 2rpx solid #cfd8d2;
  border-radius: 50%;
}

.radio.checked {
  border: 12rpx solid #16835b;
}

.name-card {
  margin-top: 24rpx;
  padding: 28rpx;
}

.avatar-card {
  margin-top: 24rpx;
  padding: 28rpx;
}

.avatar-card text {
  display: block;
  margin-bottom: 18rpx;
  color: #526159;
  font-size: 28rpx;
  font-weight: 600;
}

.avatar-picker {
  height: 128rpx;
  padding: 0 24rpx;
  border: 1rpx solid #dbe3de;
  border-radius: 22rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  gap: 20rpx;
  justify-content: flex-start;
}

.avatar-preview,
.avatar-fallback {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  flex: 0 0 auto;
}

.avatar-fallback {
  background: #315f8e;
  color: #ffffff;
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-copy {
  color: #1f2a24;
  font-size: 30rpx;
  font-weight: 600;
}

.name-card text {
  display: block;
  margin-bottom: 14rpx;
  color: #526159;
  font-size: 28rpx;
  font-weight: 600;
}

input {
  height: 92rpx;
  padding: 0 26rpx;
  border: 1rpx solid #dbe3de;
  border-radius: 22rpx;
  background: #ffffff;
  color: #1f2a24;
  font-size: 30rpx;
}

.bind-btn {
  margin-top: 36rpx;
}
