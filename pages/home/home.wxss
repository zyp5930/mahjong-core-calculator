.home-page {
  padding-top: 28rpx;
  background:
    linear-gradient(180deg, #fff5df 0%, #f8f5ec 42%, #f6f8f7 100%);
}

.top-actions {
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.mode-tag {
  min-width: 138rpx;
  height: 54rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 54rpx;
  text-align: center;
  font-weight: 600;
}

.mode-tag.cloud {
  background: #dfeecf;
  color: #16835b;
}

.mode-tag.local,
.mode-tag.unknown {
  background: #edf1ef;
  color: #68746d;
}

.top-actions navigator {
  width: 120rpx;
  height: 54rpx;
  border: 1rpx solid #d9dfdb;
  border-radius: 999rpx;
  background: #ffffff;
  color: #526159;
  font-size: 26rpx;
  line-height: 54rpx;
  text-align: center;
}

.hero-card {
  min-height: 288rpx;
  margin-bottom: 34rpx;
  padding: 38rpx 34rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 26rpx;
  background: linear-gradient(135deg, #167453 0%, #0f523f 100%);
  box-shadow: 0 20rpx 44rpx rgba(22, 116, 83, 0.2);
  display: flex;
  align-items: center;
  justify-content: space-between;
  overflow: hidden;
  position: relative;
}

.hero-card::after {
  content: "";
  position: absolute;
  right: -68rpx;
  bottom: -92rpx;
  width: 280rpx;
  height: 280rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}

.hero-copy {
  width: 430rpx;
  position: relative;
  z-index: 1;
}

.eyebrow {
  color: rgba(236, 245, 216, 0.78);
  font-size: 22rpx;
  letter-spacing: 3rpx;
  font-weight: 700;
}

.hero-title {
  margin-top: 20rpx;
  color: #ffffff;
  font-size: 44rpx;
  line-height: 1.18;
  font-weight: 800;
}

.hero-desc {
  margin-top: 20rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 27rpx;
  line-height: 1.55;
}

.hero-tiles {
  width: 178rpx;
  height: 194rpx;
  position: relative;
  z-index: 1;
  flex: 0 0 auto;
  margin-right: 4rpx;
}

.hero-tile {
  position: absolute;
  width: 86rpx;
  height: 116rpx;
  border-radius: 16rpx;
  background: linear-gradient(180deg, #fffef7 0%, #f1eadf 100%);
  color: #16835b;
  font-size: 42rpx;
  line-height: 116rpx;
  text-align: center;
  font-weight: 800;
  box-shadow: 0 12rpx 20rpx rgba(9, 47, 36, 0.18);
}

.hero-tile-back {
  right: 58rpx;
  top: 4rpx;
  transform: rotate(-10deg);
}

.hero-tile-mid {
  right: 8rpx;
  top: 54rpx;
  color: #c84636;
  transform: rotate(8deg);
}

.hero-tile-front {
  right: 78rpx;
  top: 82rpx;
  color: #315f8e;
  transform: rotate(-4deg);
}

.section-title {
  padding-left: 16rpx;
  border-left: 6rpx solid #16835b;
  color: #2c3832;
  font-size: 30rpx;
  line-height: 32rpx;
  margin-bottom: 22rpx;
  font-weight: 700;
}

.mode-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 24rpx;
}

.mode-card {
  min-height: 184rpx;
  padding: 32rpx;
  position: relative;
  overflow: hidden;
  background: #fffdf7;
}

.mode-card.highlight {
  border-color: #ecdfc9;
  box-shadow: 0 22rpx 46rpx rgba(96, 69, 34, 0.12);
}

.mode-card.highlight::after {
  content: "";
  position: absolute;
  right: -54rpx;
  top: -54rpx;
  width: 168rpx;
  height: 168rpx;
  border-radius: 50%;
  background: #edf5e8;
}

.mode-card.highlight::before {
  content: "東";
  position: absolute;
  right: 52rpx;
  top: 34rpx;
  width: 70rpx;
  height: 92rpx;
  border: 1rpx solid #eadcc4;
  border-radius: 14rpx;
  background: #fffef8;
  color: rgba(22, 131, 91, 0.2);
  font-size: 42rpx;
  line-height: 92rpx;
  text-align: center;
  font-weight: 800;
  transform: rotate(8deg);
  z-index: 1;
}

.badge {
  position: absolute;
  left: 30rpx;
  top: 0;
  min-width: 82rpx;
  height: 38rpx;
  padding: 0 14rpx;
  border-radius: 0 0 14rpx 14rpx;
  background: #c57e20;
  color: #ffffff;
  font-size: 24rpx;
  line-height: 38rpx;
  text-align: center;
  z-index: 1;
}

.mode-title {
  margin-top: 24rpx;
  font-size: 34rpx;
  color: #1f2a24;
  font-weight: 700;
  position: relative;
  z-index: 1;
}

.mode-desc {
  margin-top: 14rpx;
  color: #7d8982;
  font-size: 26rpx;
  position: relative;
  z-index: 1;
}

.mode-action {
  position: absolute;
  right: 28rpx;
  bottom: 28rpx;
  min-width: 142rpx;
  height: 56rpx;
  border-radius: 999rpx;
  background: #12855a;
  color: #ffffff;
  font-size: 26rpx;
  line-height: 56rpx;
  text-align: center;
  font-weight: 600;
  z-index: 1;
  box-shadow: 0 10rpx 20rpx rgba(18, 133, 90, 0.2);
}

.recent-title {
  margin-top: 48rpx;
}

.table-card {
  padding: 32rpx;
  margin-bottom: 28rpx;
  border-color: #eee4d4;
  background: #fffdf8;
  box-shadow: 0 22rpx 48rpx rgba(96, 69, 34, 0.11);
  position: relative;
  overflow: hidden;
}

.table-card::after {
  content: "";
  position: absolute;
  right: -34rpx;
  top: -38rpx;
  width: 142rpx;
  height: 142rpx;
  border-radius: 50%;
  background: rgba(22, 131, 91, 0.06);
}

.table-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  z-index: 1;
}

.table-name {
  font-size: 32rpx;
  color: #1f2a24;
  font-weight: 700;
}

.status {
  height: 46rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  line-height: 46rpx;
  font-weight: 600;
}

.status.active {
  background: #e3f2ea;
  color: #12855a;
}

.status.ended {
  background: #eef1ef;
  color: #7b8680;
}

.players {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
  margin-top: 26rpx;
  position: relative;
  z-index: 1;
}

.player-chip {
  min-width: 0;
  text-align: center;
}

.avatar {
  width: 76rpx;
  height: 76rpx;
  margin: 0 auto 8rpx;
  border-radius: 18rpx;
  color: #ffffff;
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.image-avatar {
  display: block;
  background: #dfe3e6;
}

.player-chip text {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 24rpx;
}

.score {
  margin-top: 6rpx;
  font-size: 34rpx;
}

.score.win {
  color: #c84636;
}

.score.lose {
  color: #526159;
}

.table-meta {
  margin-top: 24rpx;
  color: #9a8c78;
  font-size: 26rpx;
  position: relative;
  z-index: 1;
}

.empty {
  padding: 48rpx 28rpx;
  font-size: 30rpx;
  color: #2c3832;
  border-color: #eee4d4;
  background: #fffdf8;
  box-shadow: 0 22rpx 48rpx rgba(96, 69, 34, 0.11);
}

.empty .muted {
  margin-top: 12rpx;
  font-size: 26rpx;
}
