.home-page {
  padding-top: 28rpx;
  background:
    linear-gradient(180deg, #fff5df 0%, #f8f5ec 42%, #f6f8f7 100%);
}

.top-actions {
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.mode-tag {
  min-width: 138rpx;
  height: 54rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 54rpx;
  text-align: center;
  font-weight: 600;
}

.mode-tag.cloud {
  background: #dfeecf;
  color: #16835b;
}

.mode-tag.local,
.mode-tag.unknown {
  background: #edf1ef;
  color: #68746d;
}

.top-actions navigator {
  width: 120rpx;
  height: 54rpx;
  border: 1rpx solid #d9dfdb;
  border-radius: 999rpx;
  background: #ffffff;
  color: #526159;
  font-size: 26rpx;
  line-height: 54rpx;
  text-align: center;
}

.hero-card {
  min-height: 272rpx;
  margin-bottom: 34rpx;
  padding: 34rpx 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 26rpx;
  background: linear-gradient(135deg, #167453 0%, #0f523f 100%);
  box-shadow: 0 20rpx 44rpx rgba(22, 116, 83, 0.2);
  display: flex;
  align-items: center;
  justify-content: space-between;
  overflow: hidden;
  position: relative;
}

.hero-card::after {
  content: "";
  position: absolute;
  right: -68rpx;
  bottom: -92rpx;
  width: 280rpx;
  height: 280rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}

.hero-copy {
  width: 406rpx;
  position: relative;
  z-index: 1;
}

.eyebrow {
  color: rgba(236, 245, 216, 0.78);
  font-size: 22rpx;
  letter-spacing: 3rpx;
  font-weight: 700;
}

.hero-title {
  margin-top: 20rpx;
  color: #ffffff;
  font-size: 44rpx;
  line-height: 1.18;
  font-weight: 800;
}

.hero-desc {
  margin-top: 20rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 27rpx;
  line-height: 1.55;
}

.hero-stats {
  margin-top: 22rpx;
  display: flex;
  gap: 14rpx;
}

.hero-stats view {
  min-width: 104rpx;
  padding: 12rpx 14rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.08);
  color: #ffffff;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.hero-stats text {
  display: block;
}

.hero-stats view text:first-child {
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1;
}

.hero-stats view text:last-child {
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
  line-height: 1;
}

.hero-tiles {
  width: 178rpx;
  height: 194rpx;
  position: relative;
  z-index: 1;
  flex: 0 0 auto;
  margin-right: 4rpx;
}

.hero-tile {
  position: absolute;
  width: 86rpx;
  height: 116rpx;
  border-radius: 16rpx;
  background: linear-gradient(180deg, #fffef7 0%, #f1eadf 100%);
  color: #16835b;
  font-size: 42rpx;
  line-height: 116rpx;
  text-align: center;
  font-weight: 800;
  box-shadow: 0 12rpx 20rpx rgba(9, 47, 36, 0.18);
}

.hero-tile-back {
  right: 58rpx;
  top: 4rpx;
  transform: rotate(-10deg);
}

.hero-tile-mid {
  right: 8rpx;
  top: 54rpx;
  color: #c84636;
  transform: rotate(8deg);
}

.hero-tile-front {
  right: 78rpx;
  top: 82rpx;
  color: #315f8e;
  transform: rotate(-4deg);
}

.section-title {
  padding-left: 16rpx;
  border-left: 6rpx solid #16835b;
  color: #2c3832;
  font-size: 30rpx;
  line-height: 32rpx;
  margin-bottom: 22rpx;
  font-weight: 700;
}

.desk-actions {
  display: grid;
  grid-template-columns: 1fr;
  gap: 18rpx;
  margin-top: -4rpx;
}

.desk-action {
  width: 100%;
  height: 152rpx;
  box-sizing: border-box;
  padding: 24rpx 24rpx 24rpx 26rpx;
  border: 1rpx solid #eee4d4;
  border-radius: 22rpx;
  background: #fffdf8;
  box-shadow: 0 18rpx 38rpx rgba(96, 69, 34, 0.09);
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.action-primary {
  border-color: #d8ebe2;
}

.action-secondary {
  position: relative;
}

.action-disabled {
  opacity: 0.72;
}

.action-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  background: #f4f7f5;
  color: #16835b;
  font-size: 34rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
}

.action-primary .action-icon {
  background: #e3f2ea;
}

.action-secondary .action-icon {
  background: #eef3fb;
  color: #315f8e;
}

.action-main {
  flex: 1;
  min-width: 0;
}

.action-title {
  color: #1f2a24;
  font-size: 32rpx;
  font-weight: 700;
}

.action-desc {
  margin-top: 6rpx;
  color: #7d8982;
  font-size: 22rpx;
  line-height: 1.32;
  white-space: normal;
}

.action-arrow {
  color: #9aa5a0;
  font-size: 44rpx;
  line-height: 1;
  flex: 0 0 auto;
}

.recent-title {
  margin-top: 48rpx;
}

.table-card,
.group-card {
  padding: 32rpx;
  margin-bottom: 28rpx;
  border-color: #eee4d4;
  background: #fffdf8;
  box-shadow: 0 22rpx 48rpx rgba(96, 69, 34, 0.11);
  position: relative;
  overflow: hidden;
}

.table-card::after,
.group-card::after {
  content: "";
  position: absolute;
  right: -34rpx;
  top: -38rpx;
  width: 142rpx;
  height: 142rpx;
  border-radius: 50%;
  background: rgba(22, 131, 91, 0.06);
}

.group-card {
  padding: 0;
}

.group-main {
  padding: 32rpx;
  position: relative;
  z-index: 1;
}

.table-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  z-index: 1;
}

.group-title-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.table-name {
  min-width: 0;
  font-size: 32rpx;
  color: #1f2a24;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.group-count {
  height: 40rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #f4f7f5;
  color: #526159;
  font-size: 22rpx;
  line-height: 40rpx;
  flex: 0 0 auto;
}

.status {
  height: 46rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  line-height: 46rpx;
  font-weight: 600;
}

.status.active {
  background: #e3f2ea;
  color: #12855a;
}

.status.ended {
  background: #eef1ef;
  color: #7b8680;
}

.group-stats {
  margin-top: 18rpx;
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  color: #7d8982;
  font-size: 24rpx;
  position: relative;
  z-index: 1;
}

.group-stats text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.players-scroll {
  margin-top: 26rpx;
  position: relative;
  z-index: 1;
  width: 100%;
}

.players {
  display: flex;
  gap: 20rpx;
  justify-content: flex-start;
}

.players-count-5 {
  gap: 12rpx;
}

.players-scrollable .players {
  display: flex;
  gap: 12rpx;
  min-width: 100%;
}

.player-chip {
  width: 128rpx;
  flex: 0 0 128rpx;
  text-align: center;
}

.players-count-5 .player-chip,
.players-scrollable .player-chip {
  width: 104rpx;
  flex: 0 0 104rpx;
}

.avatar {
  width: 76rpx;
  height: 76rpx;
  margin: 0 auto 8rpx;
  border-radius: 18rpx;
  color: #ffffff;
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.image-avatar {
  display: block;
  background: #dfe3e6;
}

.player-chip text {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 24rpx;
}

.players-count-5 .avatar,
.players-scrollable .avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
}

.players-count-5 .player-chip text,
.players-scrollable .player-chip text {
  font-size: 22rpx;
}

.score {
  margin-top: 6rpx;
  font-size: 34rpx;
}

.players-count-5 .score,
.players-scrollable .score {
  font-size: 30rpx;
}

.score.win {
  color: #c84636;
}

.score.lose {
  color: #526159;
}

.table-meta {
  margin-top: 24rpx;
  color: #9a8c78;
  font-size: 26rpx;
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.group-actions {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.group-settle-btn {
  width: 78rpx;
  height: 44rpx;
  margin: 0;
  padding: 0 14rpx;
  border: 1rpx solid #d8ebe2;
  border-radius: 999rpx;
  background: #f7fffb;
  color: #12855a;
  font-size: 24rpx;
  line-height: 42rpx;
  font-weight: 700;
  text-align: center;
  flex: 0 0 auto;
}

.expand-text {
  color: #12855a;
  font-weight: 700;
  flex: 0 0 auto;
}

.round-list {
  margin: 0 24rpx 24rpx;
  padding: 10rpx 0;
  border-top: 1rpx solid #f0e6d6;
  position: relative;
  z-index: 1;
}

.round-row {
  padding: 20rpx 6rpx 22rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  border-bottom: 1rpx solid #f5efe6;
}

.round-row:last-child {
  border-bottom: 0;
}

.round-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.round-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.round-title {
  color: #1f2a24;
  font-size: 28rpx;
  font-weight: 700;
}

.round-meta-line {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.round-meta,
.round-multiplier {
  color: #9a8c78;
  font-size: 24rpx;
}

.round-meta {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.round-multiplier {
  height: 36rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: #f7f1e8;
  line-height: 36rpx;
  flex: 0 0 auto;
}

.round-side {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.round-status {
  height: 40rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 40rpx;
  font-weight: 600;
}

.round-status.active {
  background: #e3f2ea;
  color: #12855a;
}

.round-status.ended {
  background: #eef1ef;
  color: #7b8680;
}

.round-action {
  color: #12855a;
  font-size: 24rpx;
  font-weight: 700;
}

.round-players {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx 20rpx;
}

.round-player {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.round-avatar {
  width: 54rpx;
  height: 54rpx;
  border-radius: 14rpx;
  color: #ffffff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
}

.round-player-main {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.round-player-name {
  color: #526159;
  font-size: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.round-player-score {
  font-size: 24rpx;
  font-weight: 700;
}

.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 10;
  background: rgba(0, 0, 0, 0.35);
}

.settlement-sheet {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  z-index: 11;
  padding: 34rpx 30rpx;
  border-radius: 28rpx;
  background: #fffdf8;
  box-shadow: 0 24rpx 56rpx rgba(96, 69, 34, 0.18);
}

.settlement-title {
  color: #1f2a24;
  font-size: 36rpx;
  text-align: center;
}

.settlement-subtitle {
  margin-top: 14rpx;
  color: #7d8982;
  font-size: 26rpx;
  text-align: center;
}

.settlement-input-row {
  margin-top: 26rpx;
  border: 1rpx solid #ded7ca;
  border-radius: 22rpx;
  overflow: hidden;
}

.settlement-input-row input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  font-size: 34rpx;
  box-sizing: border-box;
}

.settlement-actions {
  margin-top: 26rpx;
  display: flex;
  gap: 16rpx;
}

.settlement-actions button {
  flex: 1;
  height: 82rpx;
  border-radius: 22rpx;
  font-size: 30rpx;
  line-height: 82rpx;
}

.settlement-actions .confirm {
  background: #12855a;
  color: #ffffff;
}

.empty {
  padding: 48rpx 28rpx;
  font-size: 30rpx;
  color: #2c3832;
  border-color: #eee4d4;
  background: #fffdf8;
  box-shadow: 0 22rpx 48rpx rgba(96, 69, 34, 0.11);
}

.empty .muted {
  margin-top: 12rpx;
  font-size: 26rpx;
}
