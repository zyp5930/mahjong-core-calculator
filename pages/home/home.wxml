<view class="page home-page">
  <view class="top-actions">
    <view class="mode-tag {{mode}}">
      {{modeText}}
    </view>
    <view></view>
    <navigator url="/pages/profile/profile">我的</navigator>
  </view>

  <view class="hero-card">
    <view class="hero-copy">
      <view class="eyebrow">牌桌记分本</view>
      <view class="hero-title">起桌、给分、结账，别糊涂</view>
      <view class="hero-desc">牌友扫码入座，分数当场落账，散场有明细。</view>
      <view class="hero-stats">
        <view>
          <text>{{quickStats.totalGroups}}</text>
          <text>桌</text>
        </view>
        <view>
          <text>{{quickStats.activeGroups}}</text>
          <text>开打</text>
        </view>
        <view>
          <text>{{quickStats.pendingGroups}}</text>
          <text>待结账</text>
        </view>
      </view>
    </view>
    <view class="hero-tiles">
      <view class="hero-tile hero-tile-back">发</view>
      <view class="hero-tile hero-tile-mid">中</view>
      <view class="hero-tile hero-tile-front">东</view>
    </view>
  </view>

  <view class="desk-actions">
    <navigator class="desk-action action-primary" url="/pages/create/create" hover-class="card-press" hover-stay-time="80">
      <view class="action-icon action-fortune-icon">
        <view class="fortune-symbol">
          <view class="fortune-tile">
            <view class="fortune-char">發</view>
          </view>
          <view class="fortune-spark">
            <view class="fortune-spark-line fortune-spark-vertical"></view>
            <view class="fortune-spark-line fortune-spark-horizontal"></view>
          </view>
        </view>
      </view>
      <view class="action-main">
        <view class="action-title">新开一桌</view>
        <view class="action-desc">桌主开局，牌友扫码入座</view>
      </view>
      <view class="action-arrow">›</view>
    </navigator>
    <view
      wx:if="{{latestGroup}}"
      class="desk-action action-secondary"
      bindtap="openLatestTable"
      hover-class="card-press"
      hover-stay-time="80"
    >
      <view class="action-icon action-latest-icon">
        <view class="clock-symbol">
          <view class="clock-face">
            <view class="clock-hand clock-hand-hour"></view>
            <view class="clock-hand clock-hand-minute"></view>
            <view class="clock-dot"></view>
          </view>
        </view>
      </view>
      <view class="action-main">
        <view class="action-title">跳转最近对局</view>
        <view class="action-desc">{{latestGroup.entryDesc}}</view>
      </view>
      <view class="action-arrow">›</view>
    </view>
    <view wx:else class="desk-action action-secondary action-disabled">
      <view class="action-icon action-latest-icon">
        <view class="clock-symbol">
          <view class="clock-face">
            <view class="clock-hand clock-hand-hour"></view>
            <view class="clock-hand clock-hand-minute"></view>
            <view class="clock-dot"></view>
          </view>
        </view>
      </view>
      <view class="action-main">
        <view class="action-title">跳转最近对局</view>
        <view class="action-desc">开过一桌后会出现在这里</view>
      </view>
    </view>
  </view>

  <view class="section-title recent-title">最近对局</view>
  <block wx:if="{{tableGroups.length}}">
    <view class="group-card card" wx:for="{{tableGroups}}" wx:key="groupId">
      <view class="group-main" bindtap="toggleGroup" data-id="{{item.groupId}}" hover-class="card-press" hover-stay-time="80">
        <view class="table-top">
          <view class="group-title-wrap">
            <text class="table-name">{{item.name}}</text>
            <text class="group-count">{{item.tableCount}}局</text>
          </view>
          <text class="status {{item.status}}">{{item.statusText}}</text>
        </view>
        <view class="group-stats">
          <text>{{item.summaryText}}</text>
          <text>{{item.updatedText}} 更新</text>
        </view>
        <scroll-view class="players-scroll {{item.canScrollPlayers ? 'players-scrollable' : ''}}" scroll-x="{{item.canScrollPlayers}}" enable-flex="{{item.canScrollPlayers}}">
          <view class="players players-count-{{item.playerColumnCount}}">
            <view class="player-chip" wx:for="{{item.players}}" wx:for-item="player" wx:key="id">
              <image wx:if="{{player.avatarUrl}}" class="avatar image-avatar" src="{{player.avatarUrl}}" mode="aspectFill"></image>
              <view wx:else class="avatar" style="background: {{player.avatarColor}}">{{player.initial}}</view>
              <text>{{player.name}}</text>
              <text class="{{player.score >= 0 ? 'score win' : 'score lose'}}">{{player.scoreText}}</text>
            </view>
          </view>
        </scroll-view>
        <view class="table-meta">
          <text>{{item.createdText}} 开始</text>
          <view class="group-actions">
            <text wx:if="{{item.canSettleGroupFromHome}}" class="group-settle-btn" catchtap="settleGroupFromHome" data-id="{{item.settleTableId}}">结算</text>
            <text class="group-delete-btn" catchtap="deleteGroup" data-id="{{item.settleTableId}}">删除</text>
            <text class="expand-text">{{item.isExpanded ? '收起' : '展开'}}</text>
          </view>
        </view>
      </view>

      <view class="round-list" wx:if="{{item.isExpanded}}">
        <view wx:if="{{item.hasSettlementScores}}" class="round-score-action">
          <button
            class="round-score-toggle"
            catchtap="toggleSettlementScores"
            data-id="{{item.groupId}}"
          >{{item.showSettlementScores ? '原始' : '结算'}}</button>
        </view>
        <view class="round-row" wx:for="{{item.tables}}" wx:for-item="round" wx:key="id" catchtap="openGroupTable" data-id="{{round.id}}">
          <view class="round-head">
            <view class="round-main">
              <text class="round-title">{{round.roundText}}</text>
              <view class="round-meta-line">
                <text class="round-meta">{{round.createdText}} | {{round.durationText}}</text>
              </view>
            </view>
            <view class="round-side">
              <text class="round-status {{round.status}}">{{round.statusText}}</text>
              <text class="round-action">进入</text>
            </view>
          </view>
          <scroll-view class="round-players-scroll {{round.canScrollRoundPlayers ? 'round-players-scrollable' : ''}}" scroll-x="{{round.canScrollRoundPlayers}}" enable-flex="{{round.canScrollRoundPlayers}}">
            <view class="round-players round-players-count-{{round.roundPlayerColumnCount}}">
              <view class="round-player" wx:for="{{round.roundPlayers}}" wx:for-item="player" wx:key="id">
                <image wx:if="{{player.avatarUrl}}" class="round-avatar image-avatar" src="{{player.avatarUrl}}" mode="aspectFill"></image>
                <view wx:else class="round-avatar" style="background: {{player.avatarColor}}">{{player.initial}}</view>
                <view class="round-player-main">
                  <text class="round-player-name">{{player.name}}</text>
                  <text class="round-player-score {{player.score >= 0 ? 'win' : 'lose'}}">{{player.displayScoreText}}</text>
                </view>
              </view>
            </view>
          </scroll-view>
        </view>
      </view>
    </view>
  </block>
  <view wx:else class="empty card">
    <view>{{emptyTitle}}</view>
    <view class="muted">{{emptySubtitle}}</view>
  </view>

  <view class="sheet-mask" wx:if="{{settlementVisible}}" bindtap="closeHomeSettlement"></view>
  <view class="settlement-sheet" wx:if="{{settlementVisible}}">
    <view class="settlement-title">结算本次对局</view>
    <view class="settlement-subtitle">请输入倍率后结算本次对局</view>
    <view class="settlement-input-row">
      <input type="digit" value="{{settlementInputValue}}" bindinput="onHomeSettlementInput" placeholder="例如 0.3" />
    </view>
    <view class="settlement-actions">
      <button bindtap="closeHomeSettlement">取消</button>
      <button class="confirm" bindtap="confirmHomeSettlement">结算</button>
    </view>
  </view>
</view>
