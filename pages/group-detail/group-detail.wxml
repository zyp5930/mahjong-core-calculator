<view class="page group-detail-page" bindtap="clearTrendSelection">
  <view class="entertainment-notice">仅供娱乐。积分不代表金钱，不得用于赌博、兑换或资金结算。</view>
  <view wx:if="{{group}}">
    <view class="summary card">
      <view>
        <view class="summary-title">{{group.name}}</view>
        <view class="muted">共 {{group.tableCount}} 局</view>
      </view>
      <text class="status {{group.status}}">{{group.statusText}}</text>
    </view>

    <view class="round-list card">
      <view class="round-row" wx:for="{{group.rounds}}" wx:key="id" bindtap="openRound" data-id="{{item.id}}" hover-class="round-press" hover-stay-time="80">
        <view class="round-head">
          <view>
            <text class="round-title">{{item.roundText}}</text>
            <text class="round-meta">{{item.createdText}} | {{item.durationText}}</text>
          </view>
          <view class="round-side">
            <text class="round-status {{item.status}}">{{item.statusText}}</text>
            <text class="round-action" catchtap="openRound" data-id="{{item.id}}">进入</text>
          </view>
        </view>
        <scroll-view class="players-scroll {{item.canScrollPlayers ? 'players-scrollable' : ''}}" scroll-x="{{item.canScrollPlayers}}" enable-flex="{{item.canScrollPlayers}}">
          <view class="players players-count-{{item.playerColumnCount}}">
            <view class="player" wx:for="{{item.players}}" wx:for-item="player" wx:key="id">
              <image wx:if="{{player.avatarUrl}}" class="avatar image-avatar" src="{{player.avatarUrl}}" mode="aspectFill"></image>
              <view wx:else class="avatar" style="background: {{player.avatarColor}}">{{player.initial}}</view>
              <text class="player-name">{{player.name}}</text>
              <text class="player-score {{player.score >= 0 ? 'win' : 'lose'}}">{{player.scoreText}}</text>
            </view>
          </view>
        </scroll-view>
      </view>
    </view>
  <view class="score-trends" wx:if="{{group && (showScoreTrends || roundTrendTables.length)}}">
    <view class="trend-panel card" wx:if="{{showMyScoreTrend}}">
      <view class="trend-title">我的分数走势</view>
      <view class="trend-legend">
        <text class="trend-dot my-dot"></text>
        <text>{{myTrendName}}</text>
      </view>
      <canvas
        type="2d"
        id="my-score-chart"
        class="trend-canvas"
        data-chart-id="my-score-chart"
        catchtap="keepTrendSelection"
        catchtouchstart="onTrendTouchStart"
        catchtouchmove="onTrendTouchMove"
        catchtouchend="onTrendTouchEnd"
        catchtouchcancel="onTrendTouchEnd"
        catchlongpress="onTrendLongPress"
        catchlongtap="onTrendLongPress"
      ></canvas>
    </view>

    <view class="trend-panel card" wx:if="{{roundTrendTables.length}}">
      <view class="trend-title">单局给分走势</view>
      <scroll-view class="round-trend-tabs" scroll-x="true" enable-flex="true">
        <view class="round-trend-tab-list">
          <view
            wx:for="{{roundTrendTables}}"
            wx:key="id"
            class="round-trend-tab {{item.selected ? 'selected' : ''}}"
            bindtap="selectRoundTrend"
            data-id="{{item.id}}"
          >{{item.label}}</view>
        </view>
      </scroll-view>
      <view class="trend-legend all-trend-legend" wx:if="{{showRoundTrend}}">
        <view wx:for="{{roundTrendPlayers}}" wx:key="id" class="trend-legend-item">
          <text class="trend-dot" style="background: {{item.color}}"></text>
          <text>{{item.name}}</text>
        </view>
      </view>
      <view wx:if="{{roundTrendLoading}}" class="trend-empty">正在加载本局给分记录</view>
      <canvas
        wx:elif="{{showRoundTrend}}"
        type="2d"
        id="round-score-chart"
        class="trend-canvas"
        data-chart-id="round-score-chart"
        catchtap="keepTrendSelection"
        catchtouchstart="onTrendTouchStart"
        catchtouchmove="onTrendTouchMove"
        catchtouchend="onTrendTouchEnd"
        catchtouchcancel="onTrendTouchEnd"
        catchlongpress="onTrendLongPress"
        catchlongtap="onTrendLongPress"
      ></canvas>
      <view wx:else class="trend-empty">本局还没有有效给分记录</view>
    </view>

    <view class="trend-panel card" wx:if="{{roundTrendTables.length}}">
      <view class="trend-title">单局赢局走势</view>
      <scroll-view class="round-trend-tabs" scroll-x="true" enable-flex="true">
        <view class="round-trend-tab-list">
          <view
            wx:for="{{roundTrendTables}}"
            wx:key="id"
            class="round-trend-tab {{item.selected ? 'selected' : ''}}"
            bindtap="selectRoundTrend"
            data-id="{{item.id}}"
          >{{item.label}}</view>
        </view>
      </scroll-view>
      <view class="trend-legend all-trend-legend" wx:if="{{showRoundWinTrend}}">
        <view wx:for="{{roundWinPlayers}}" wx:key="id" class="trend-legend-item">
          <text class="trend-dot" style="background: {{item.color}}"></text>
          <text>{{item.name}}</text>
        </view>
      </view>
      <view wx:if="{{roundTrendLoading}}" class="trend-empty">正在加载本局给分记录</view>
      <canvas
        wx:elif="{{showRoundWinTrend}}"
        type="2d"
        id="round-win-chart"
        class="trend-canvas"
        data-chart-id="round-win-chart"
        catchtap="keepTrendSelection"
        catchtouchstart="onTrendTouchStart"
        catchtouchmove="onTrendTouchMove"
        catchtouchend="onTrendTouchEnd"
        catchtouchcancel="onTrendTouchEnd"
        catchlongpress="onTrendLongPress"
        catchlongtap="onTrendLongPress"
      ></canvas>
      <view wx:else class="trend-empty">本局还没有有效给分记录</view>
    </view>

    <view class="trend-panel card" wx:if="{{showGroupWinTrend}}">
      <view class="trend-title">全局赢局走势</view>
      <view class="trend-legend all-trend-legend">
        <view wx:for="{{groupWinPlayers}}" wx:key="id" class="trend-legend-item">
          <text class="trend-dot" style="background: {{item.color}}"></text>
          <text>{{item.name}}</text>
        </view>
      </view>
      <canvas
        type="2d"
        id="group-win-chart"
        class="trend-canvas"
        data-chart-id="group-win-chart"
        catchtap="keepTrendSelection"
        catchtouchstart="onTrendTouchStart"
        catchtouchmove="onTrendTouchMove"
        catchtouchend="onTrendTouchEnd"
        catchtouchcancel="onTrendTouchEnd"
        catchlongpress="onTrendLongPress"
        catchlongtap="onTrendLongPress"
      ></canvas>
    </view>

    <view class="trend-panel card" wx:if="{{showScoreTrends}}">
      <view class="trend-title">全员分数走势</view>
      <view class="trend-legend all-trend-legend">
        <view wx:for="{{allTrendPlayers}}" wx:key="id" class="trend-legend-item">
          <text class="trend-dot" style="background: {{item.color}}"></text>
          <text>{{item.name}}</text>
        </view>
      </view>
      <canvas
        type="2d"
        id="all-score-chart"
        class="trend-canvas"
        data-chart-id="all-score-chart"
        catchtap="keepTrendSelection"
        catchtouchstart="onTrendTouchStart"
        catchtouchmove="onTrendTouchMove"
        catchtouchend="onTrendTouchEnd"
        catchtouchcancel="onTrendTouchEnd"
        catchlongpress="onTrendLongPress"
        catchlongtap="onTrendLongPress"
      ></canvas>
    </view>
  </view>
  </view>
  <view wx:elif="{{!loading}}" class="empty card">找不到这组对局</view>
</view>
