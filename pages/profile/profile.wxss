.profile-card {
  padding: 34rpx;
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 24rpx;
  background: #12855a;
  color: #ffffff;
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 22rpx rgba(18, 133, 90, 0.2);
}

.name {
  margin-bottom: 8rpx;
  font-size: 34rpx;
  color: #1f2a24;
  font-weight: 800;
}

.menu {
  margin-top: 24rpx;
  overflow: hidden;
}

.menu button {
  height: 104rpx;
  width: 100%;
  padding: 0 28rpx;
  border-bottom: 1rpx solid #f0e6d6;
  color: #1f2a24;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: transparent;
  text-align: left;
  white-space: nowrap;
}

.menu button:last-child {
  border-bottom: 0;
}

.menu-label {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  line-height: 1.2;
}

.menu-arrow {
  flex: 0 0 32rpx;
  margin-left: 18rpx;
  color: #9aa5a0;
  font-size: 40rpx;
  line-height: 1;
  text-align: right;
}

.arrow {
  color: #9aa5a0;
  font-size: 40rpx;
}

.legal-link { padding: 32rpx 28rpx; font-size: 30rpx; border-bottom: 1rpx solid #f0e6d6; }
.contact-detail { margin-top: 24rpx; font-size: 26rpx; line-height: 1.7; color: #526159; }
