.profile-card {
  padding: 34rpx;
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 24rpx;
  background: #12855a;
  color: #ffffff;
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 22rpx rgba(18, 133, 90, 0.2);
}

.name {
  margin-bottom: 8rpx;
  font-size: 34rpx;
  color: #1f2a24;
  font-weight: 800;
}

.menu {
  margin-top: 24rpx;
  overflow: hidden;
}

.menu button {
  height: 104rpx;
  padding: 0 28rpx;
  border-bottom: 1rpx solid #f0e6d6;
  color: #1f2a24;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: transparent;
}

.menu button:last-child {
  border-bottom: 0;
}

.arrow {
  color: #9aa5a0;
  font-size: 40rpx;
}
