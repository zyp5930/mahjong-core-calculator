.summary {
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.summary-title {
  margin-bottom: 10rpx;
  font-size: 34rpx;
  color: #1f2a24;
  font-weight: 800;
}

.status {
  height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  line-height: 48rpx;
}

.status.active {
  background: #e8f5ef;
  color: #16835b;
}

.status.ended {
  background: #edf1ef;
  color: #7d8982;
}

.rank {
  margin-top: 24rpx;
  padding: 30rpx;
}

.rank-title {
  margin-bottom: 18rpx;
  color: #526159;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.rank-title::before {
  content: "";
  width: 10rpx;
  height: 30rpx;
  border-radius: 999rpx;
  background: #16835b;
  display: block;
}

.rank-row {
  min-height: 54rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 30rpx;
}

.win {
  color: #c84636;
  font-weight: 700;
}

.lose {
  color: #526159;
  font-weight: 700;
}

.record-list {
  margin-top: 24rpx;
}

.record {
  margin-bottom: 18rpx;
  padding: 26rpx 30rpx;
}

.record-main {
  font-size: 30rpx;
  color: #1f2a24;
}

.amount {
  color: #c84636;
  font-size: 34rpx;
  font-weight: 700;
}

.settlement-detail {
  display: block;
  margin-top: 10rpx;
  color: #526159;
  font-size: 26rpx;
}

.revoked {
  margin-left: 14rpx;
  color: #9aa5a0;
  font-size: 24rpx;
}

.time {
  margin-top: 12rpx;
  font-size: 24rpx;
}

.empty {
  padding: 52rpx 30rpx;
  font-size: 30rpx;
  color: #2c3832;
}
