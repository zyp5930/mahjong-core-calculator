.summary {
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.summary-title {
  margin-bottom: 10rpx;
  font-size: 34rpx;
  color: #1f2a24;
  font-weight: 800;
}

.status {
  height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  line-height: 48rpx;
}

.status.active {
  background: #e3f2ea;
  color: #12855a;
}

.status.ended {
  background: #eef1ef;
  color: #7b8680;
}

.rank {
  margin-top: 24rpx;
  padding: 30rpx;
}

.trend {
  margin-top: 24rpx;
  padding: 30rpx;
  overflow: hidden;
}

.trend-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.trend-header .rank-title {
  margin-bottom: 0;
}

.trend-hint {
  color: #8a9690;
  font-size: 24rpx;
}

.trend-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx 24rpx;
  margin: 22rpx 0 8rpx;
  color: #526159;
  font-size: 24rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  max-width: 45%;
}

.legend-item text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  flex: none;
}

.trend-canvas-wrap {
  position: relative;
  width: 100%;
  height: 440rpx;
  margin-top: 8rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.trend-canvas {
  position: absolute;
  left: 0;
  top: 0;
  display: block;
  width: 100%;
  height: 100%;
}

.trend-empty {
  padding: 90rpx 0 70rpx;
  color: #8a9690;
  font-size: 26rpx;
  text-align: center;
}

.rank-title {
  margin-bottom: 18rpx;
  color: #526159;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.rank-title::before {
  content: "";
  width: 10rpx;
  height: 30rpx;
  border-radius: 999rpx;
  background: #12855a;
  display: block;
}

.rank-row {
  min-height: 54rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 30rpx;
}

.win {
  color: #c84636;
  font-weight: 700;
}

.lose {
  color: #526159;
  font-weight: 700;
}

.record-list {
  margin-top: 24rpx;
}

.record {
  margin-bottom: 18rpx;
  padding: 26rpx 30rpx;
  position: relative;
  overflow: hidden;
}

.record::after {
  content: "";
  position: absolute;
  right: -40rpx;
  top: -44rpx;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(18, 133, 90, 0.05);
}

.record-main {
  font-size: 30rpx;
  color: #1f2a24;
  position: relative;
  z-index: 1;
}

.amount {
  color: #c84636;
  font-size: 34rpx;
  font-weight: 700;
}

.revoked {
  margin-left: 14rpx;
  color: #9aa5a0;
  font-size: 24rpx;
}

.time {
  margin-top: 12rpx;
  font-size: 24rpx;
  position: relative;
  z-index: 1;
}

.empty {
  padding: 52rpx 30rpx;
  font-size: 30rpx;
  color: #2c3832;
}
