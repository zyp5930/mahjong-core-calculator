<view class="page detail-page" bindtap="clearTrendSelection">
  <view wx:if="{{table.id}}">
    <view class="summary card">
      <view>
        <view class="summary-title">{{table.name}}</view>
        <view class="muted">分享码：{{table.shareCode}}</view>
      </view>
      <view class="status {{table.status}}">{{table.statusText}}</view>
    </view>

    <view class="rank card">
      <view class="rank-title">当前战绩</view>
      <view class="rank-row" wx:for="{{players}}" wx:key="id">
        <text>{{item.name}}</text>
        <text class="{{item.score >= 0 ? 'win' : 'lose'}}">{{item.score}}</text>
      </view>
    </view>

    <view class="trend card">
      <view class="trend-header">
        <view class="rank-title">分数走势</view>
        <view class="trend-hint">局内变化 · 同时段给分合并</view>
      </view>
      <view class="trend-legend">
        <view class="legend-item" wx:for="{{trendPlayers}}" wx:key="id">
          <view class="legend-dot" style="background: {{item.color}}"></view>
          <text>{{item.name}}</text>
        </view>
      </view>
      <view wx:if="{{trendHasRecords}}" class="trend-canvas-wrap">
        <canvas
          id="scoreTrendCanvas"
          type="2d"
          class="trend-canvas"
          catchtap="onTrendTap"
          catchtouchstart="onTrendTouchStart"
          catchtouchmove="onTrendTouchMove"
          catchtouchend="onTrendTouchEnd"
          catchtouchcancel="onTrendTouchEnd"
        ></canvas>
      </view>
      <view wx:else class="trend-empty">完成第一笔计分后显示走势</view>
    </view>

    <view class="rank card" wx:if="{{table.status === 'ended' && settlement}}">
      <view class="rank-title">结算结果</view>
      <view class="rank-row" wx:for="{{settlement.finalScores}}" wx:key="playerId">
        <text>{{item.name}}</text>
        <text>{{item.rawScore}} × {{settlement.multiplier}} = {{item.finalScore}}</text>
      </view>
    </view>

    <view class="record-list">
      <view class="record card" wx:for="{{records}}" wx:key="id">
        <view class="record-main" wx:if="{{item.isSettlement}}">
          <text>牌局结算</text>
          <text class="muted"> 倍率 </text>
          <text class="amount">{{item.multiplier}}</text>
          <text wx:for="{{item.finalScores}}" wx:for-item="score" wx:key="playerId" class="settlement-detail">
            {{score.name}}：{{score.rawScore}}×{{item.multiplier}}={{score.finalScore}}
          </text>
        </view>
        <view class="record-main" wx:else>
          <text>{{item.fromPlayerName}}</text>
          <text class="muted"> 给 </text>
          <text>{{item.toPlayerName}}</text>
          <text class="amount"> {{item.amount}} </text>
          <text>分</text>
          <text wx:if="{{item.statusText}}" class="revoked">{{item.statusText}}</text>
        </view>
        <view class="muted time">{{item.timeText}}</view>
      </view>
      <view wx:if="{{!records.length}}" class="empty card">还没有计分明细</view>
    </view>
  </view>
  <view wx:else class="empty card">
    <view>暂无牌局</view>
    <view class="muted">先创建一桌再查看明细。</view>
  </view>
</view>
