<view class="page create-page">
  <view class="form card">
    <view class="form-header">
      <view>
        <view class="form-title">开一桌麻将</view>
        <view class="form-subtitle">设置桌名和桌主资料</view>
      </view>
      <view class="mini-tiles">
        <view>东</view>
        <view>中</view>
      </view>
    </view>
    <view class="field">
      <text class="label">牌局名称</text>
      <input value="{{name}}" bindinput="onNameInput" placeholder="例如：周末麻将" />
    </view>
    <view class="field avatar-field">
      <text class="label">桌主头像</text>
      <view class="avatar-picker">
        <image wx:if="{{ownerAvatarUrl}}" class="avatar-preview" src="{{ownerAvatarUrl}}" mode="aspectFill"></image>
        <view wx:else class="avatar-fallback">{{ownerName.slice(0, 1) || '微'}}</view>
        <view class="avatar-copy">{{ownerAvatarUrl ? '重新选择头像' : '选择微信头像'}}</view>
      </view>
      <button class="avatar-hit-area" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" hover-class="none"></button>
    </view>
    <view class="field">
      <text class="label">桌主昵称</text>
      <input
        type="nickname"
        value="{{ownerName}}"
        focus="{{ownerNameInputFocus}}"
        cursor="{{ownerName.length}}"
        bindinput="onOwnerNameInput"
        bindblur="onOwnerNameBlur"
        placeholder="输入你的微信昵称"
      />
    </view>
    <view class="hint">创建后默认只有你自己，牌友可通过微信卡片加入。</view>
  </view>

  <button
    class="primary-btn submit"
    loading="{{creating}}"
    disabled="{{creating}}"
    bindtap="createTable"
  >创建并进入牌局</button>
</view>
