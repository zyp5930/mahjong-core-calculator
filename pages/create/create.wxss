.form {
  padding: 34rpx;
  overflow: hidden;
}

.form-header {
  margin-bottom: 34rpx;
  padding-bottom: 30rpx;
  border-bottom: 1rpx solid #f0e6d6;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.form-title {
  color: #1f2a24;
  font-size: 36rpx;
  line-height: 1.2;
  font-weight: 800;
}

.form-subtitle {
  margin-top: 10rpx;
  color: #7d8982;
  font-size: 26rpx;
}

.mini-tiles {
  width: 112rpx;
  height: 76rpx;
  position: relative;
  flex: 0 0 auto;
}

.mini-tiles view {
  position: absolute;
  width: 54rpx;
  height: 72rpx;
  border: 1rpx solid #eadcc4;
  border-radius: 12rpx;
  background: #fffef8;
  color: #16835b;
  font-size: 28rpx;
  line-height: 72rpx;
  text-align: center;
  font-weight: 800;
  box-shadow: 0 8rpx 16rpx rgba(96, 69, 34, 0.1);
}

.mini-tiles view:first-child {
  right: 48rpx;
  top: 0;
  transform: rotate(-8deg);
}

.mini-tiles view:last-child {
  right: 8rpx;
  top: 8rpx;
  color: #c84636;
  transform: rotate(7deg);
}

.field + .field {
  margin-top: 34rpx;
}

.label {
  display: block;
  margin-bottom: 16rpx;
  color: #526159;
  font-size: 28rpx;
  font-weight: 600;
}

input {
  height: 92rpx;
  padding: 0 26rpx;
  border: 1rpx solid #ded7ca;
  border-radius: 22rpx;
  background: #ffffff;
  color: #1f2a24;
  font-size: 30rpx;
}

.avatar-picker {
  height: 128rpx;
  padding: 0 24rpx;
  border: 1rpx solid #ded7ca;
  border-radius: 22rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  gap: 20rpx;
  justify-content: flex-start;
}

.avatar-preview,
.avatar-fallback {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  flex: 0 0 auto;
}

.avatar-fallback {
  background: #315f8e;
  color: #ffffff;
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-copy {
  color: #1f2a24;
  font-size: 30rpx;
  font-weight: 600;
}

.hint {
  margin-top: 26rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #d8ebe2;
  border-radius: 20rpx;
  background: #f7fbf6;
  color: #3d6f5a;
  font-size: 26rpx;
  line-height: 1.5;
}

.submit {
  margin-top: 38rpx;
}
