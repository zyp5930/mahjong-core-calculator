.form {
  padding: 30rpx;
}

.field + .field {
  margin-top: 32rpx;
}

.label {
  display: block;
  margin-bottom: 16rpx;
  color: #626970;
  font-size: 28rpx;
}

input {
  height: 84rpx;
  padding: 0 22rpx;
  border: 1rpx solid #dfe3e6;
  border-radius: 8rpx;
  background: #ffffff;
  font-size: 30rpx;
}

.avatar-picker {
  height: 120rpx;
  padding: 0 22rpx;
  border: 1rpx solid #dfe3e6;
  border-radius: 8rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  gap: 20rpx;
  justify-content: flex-start;
}

.avatar-preview,
.avatar-fallback {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  flex: 0 0 auto;
}

.avatar-fallback {
  background: #6b9fe8;
  color: #ffffff;
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-copy {
  color: #303438;
  font-size: 30rpx;
}

.hint {
  margin-top: 22rpx;
  color: #8a5a00;
  font-size: 26rpx;
  line-height: 1.5;
}

.submit {
  margin-top: 36rpx;
}
